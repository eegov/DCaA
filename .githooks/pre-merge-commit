#!/bin/sh
# Git-хук pre-merge-commit: релизный шлюз для dev.
# Ветку feature/* или fix/* нельзя влить в dev без отчёта ревью docs/reviews/<ветка>.md,
# который пишет субагент-ревьюер в чистом контексте (скилл code-review).
# Хук срабатывает при git merge --no-ff (при fast-forward merge-коммита нет).
[ "$(git branch --show-current)" = "dev" ] || exit 0

merged=$(git name-rev --name-only --refs='refs/heads/*' "$(cat "$(git rev-parse --git-dir)/MERGE_HEAD")")
case "$merged" in
  feature/*|fix/*) ;;
  *) exit 0 ;;
esac

report="docs/reviews/$(echo "$merged" | tr '/' '-').md"
if ! git cat-file -e "MERGE_HEAD:$report" 2>/dev/null; then
  echo "pre-merge-commit: в ветке $merged нет отчёта ревью $report."
  echo "Запусти скилл code-review, закрой блокирующие замечания и закоммить отчёт в ветку."
  exit 1
fi
