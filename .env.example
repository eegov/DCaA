# Скопируйте в .env и при необходимости поменяйте значения. .env не коммитится.
# Его читают и Docker Compose, и локально запущенный сервис.
DB_NAME=students
DB_USER=students
DB_PASSWORD=students
# Порт БД на хосте. Если 5432 занят (например, установленной на хост PostgreSQL), поставьте 55432.
DB_PORT=5432
# Порт сервиса на хосте в контейнерном режиме.
APP_PORT=8080
