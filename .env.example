# Скопируй в .env и при необходимости поменяй. .env не коммитится.
# Его читают и Docker Compose, и локально запущенный сервис.
DB_NAME=students
DB_USER=students
DB_PASSWORD=students
# Порт БД на хосте. Если 5432 занят (например, пробросом из WSL), поставь 55432.
DB_PORT=5432
# Порт сервиса на хосте в контейнерном режиме.
APP_PORT=8080
